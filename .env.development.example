# ==============================================================================
# SmartAdvisor NSU — Development Environment Template
# Copy to .env (or service-level .env) for local development.
# Do NOT commit real secrets or production credentials.
# ==============================================================================

# --- Core API Server (services/api) ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL 16 (leave unset in services/api for automatic in-memory mode) ---
DATABASE_URL=postgresql://smartadvisor:smartadvisor_secret@localhost:5432/smartadvisor_db
PG_POOL_MAX=20

# --- Redis 7 (Pub/Sub & BullMQ; leave unset for in-memory EventEmitter bus) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Authentication & Security ---
JWT_SECRET=replace-with-dev-jwt-secret-at-least-16-chars
JWT_EXPIRES_IN=15m
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1
CSRF_ENFORCE=false

# --- Rate Limiting ---
API_RATE_LIMIT_MAX=120
API_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_WINDOW_MS=60000

# --- Academic & RDS Worker Settings ---
DEMO_DEFAULT_PASSWORD=SmartAdvisor2025!
CURRENT_SEMESTER=Spring 2025
RDS_BASE_URL=

# --- Next.js Web Portal (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_DEMO_DEFAULT_PASSWORD=SmartAdvisor2025!

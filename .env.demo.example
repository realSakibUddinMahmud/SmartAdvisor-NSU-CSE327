# ==============================================================================
# SmartAdvisor NSU — Live Presentation & Docker Demo Environment Template
# Tailored for running the full 6-container Docker Compose stack behind NGINX :80.
# ==============================================================================

# --- Core API Server (services/api) ---
PORT=4000
NODE_ENV=production

# --- PostgreSQL 16 (Docker Compose network) ---
DATABASE_URL=postgresql://smartadvisor:smartadvisor_secret@postgres:5432/smartadvisor_db
PG_POOL_MAX=20

# --- Redis 7 (Docker Compose network) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Authentication & Security ---
JWT_SECRET=smartadvisor-demo-presentation-jwt-secret-2026
JWT_EXPIRES_IN=15m
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
CSRF_ENFORCE=false

# --- Rate Limiting (generous ceiling for multi-tab live demos) ---
API_RATE_LIMIT_MAX=300
API_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_WINDOW_MS=60000

# --- Academic & RDS Worker Settings (simulated headless RDS by default) ---
DEMO_DEFAULT_PASSWORD=SmartAdvisor2025!
CURRENT_SEMESTER=Spring 2025
RDS_BASE_URL=

# --- Next.js Web Portal (apps/web via NGINX :80) ---
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws
NEXT_PUBLIC_DEMO_DEFAULT_PASSWORD=SmartAdvisor2025!

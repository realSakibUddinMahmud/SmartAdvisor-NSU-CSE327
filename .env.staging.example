# ==============================================================================
# SmartAdvisor NSU — Staging Environment Template
# Hardened production-like configuration behind NGINX reverse proxy.
# Replace all placeholder secrets before deploying.
# ==============================================================================

# --- Core API Server (services/api) ---
PORT=4000
NODE_ENV=production

# --- PostgreSQL 16 ---
DATABASE_URL=postgresql://smartadvisor_staging:CHANGE_ME_PG_PASSWORD@postgres:5432/smartadvisor_staging
PG_POOL_MAX=20

# --- Redis 7 ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Authentication & Security ---
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_MIN_32_CHARACTERS_LONG
JWT_EXPIRES_IN=15m
CORS_ALLOWED_ORIGINS=https://staging-smartadvisor.example.edu,http://localhost
CSRF_ENFORCE=true

# --- Rate Limiting ---
API_RATE_LIMIT_MAX=120
API_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_WINDOW_MS=60000

# --- Academic & RDS Worker Settings ---
DEMO_DEFAULT_PASSWORD=CHANGE_ME_STAGING_SEED_PASSWORD
CURRENT_SEMESTER=Spring 2025
RDS_BASE_URL=https://rds-sandbox.example.edu

# --- Next.js Web Portal (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws
NEXT_PUBLIC_DEMO_DEFAULT_PASSWORD=CHANGE_ME_STAGING_SEED_PASSWORD
